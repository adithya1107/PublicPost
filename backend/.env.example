# Copy to .env for local development. Never commit .env.

# development | production (production turns off the /docs pages)
APP_ENV=development

# Local SQLite by default. In production use PostgreSQL, for example:
#   postgresql://user:password@host:5432/publicpost
DATABASE_URL=sqlite:///./publicpost.db

# Required, at least 32 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Lifetime of login tokens
JWT_EXPIRE_DAYS=30

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Background RSS fetching. Runs at startup, then on this interval.
INGESTION_ENABLED=true
INGESTION_INTERVAL_MINUTES=20

# Older articles are deleted, unless they have comments
ARTICLE_RETENTION_DAYS=14

# Limits on login, registration, comments and votes. Keep this on in production.
RATE_LIMITS_ENABLED=true
